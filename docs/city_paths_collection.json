    {
      "name": "Reports",
      "description": "Safety reports submission and retrieval",
      "item": [
        {
          "name": "Submit Safety Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"poor_lighting\",\n  \"description\": \"Street light is completely broken on this corner\",\n  \"urgencyLevel\": \"medium\",\n  \"latitude\": 32.0853,\n  \"longitude\": 34.7818\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/reports/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "submit"]
            },
            "description": "Submit a new safety report. Categories: poor_lighting, suspicious_gathering, road_hazard, violence_assault, harassment, police_security"
          }
        },
        {
          "name": "Submit Test Report for Voting",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
