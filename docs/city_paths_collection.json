            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"poor_lighting\",\n  \"description\": \"Test report for voting\",\n  \"urgencyLevel\": \"medium\",\n  \"latitude\": 32.0853,\n  \"longitude\": 34.7818\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/reports/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "submit"]
            },
            "description": "Submit a test report for demonstrating voting functionality"
          }
        },
        {
          "name": "Get Nearby Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/reports/nearby?lat=32.0853&lng=34.7818&radius=2",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "nearby"],
              "query": [
                {
                  "key": "lat",
                  "value": "32.0853",
                  "description": "Latitude coordinate"
                },
                {
                  "key": "lng",
                  "value": "34.7818",
                  "description": "Longitude coordinate"
                },
                {
                  "key": "radius",
                  "value": "2",
                  "description": "Search radius in kilometers"
                }
              ]
            },
            "description": "Get safety reports near a specific location"
          }
        },
        {
          "name": "Vote on Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vote\": \"up\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/reports/5/vote",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "5", "vote"]
            },
            "description": "Vote on a report (up/down). Change the report ID in the URL. Users cannot vote on their own reports."
          }
        }
      ]
    },
